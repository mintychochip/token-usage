{
  "description": "Sync Grok usage fragments into the token-usage store",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/scripts/report.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/scripts/report.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
